# Copy this file to .env and fill in real values before running.
# Never commit the real .env file to version control.

DEBUG=True
SECRET_KEY=replace-this-with-a-long-random-string

# Comma-separated list of allowed hosts (no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin for CORS (no trailing slash)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Email settings — leave blank to skip email delivery and store submissions only
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@voke.in
CONTACT_RECIPIENT_EMAIL=hello@voke.in
